[Unit]
Description=m0clip development server
After=network-online.target

[Service]
WorkingDirectory=%h/m0clip-ts
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node %h/m0clip-ts/node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5176 --strictPort
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
