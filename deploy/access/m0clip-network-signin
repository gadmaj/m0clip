#!/usr/bin/env python3
"""Authenticate this computer in Chrome without printing pairing URLs."""
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys
import urllib.parse


def main():
    os.umask(0o077)
    root = Path.home() / ".local/share/unitree-private-network/bin"
    endpoint = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "unitree-private-network/tailscaled.sock"
    state = Path.home() / ".local/state/unitree-private-network"
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    hostname = ("m0clip-client-" + re.sub(r"[^a-z0-9-]", "-", socket.gethostname().lower()))[:63].rstrip("-")
    subprocess.run(["systemctl", "--user", "start", "unitree-private-network.service"], check=True)
    command = [
        str(root / "tailscale"), f"--socket={endpoint}", "up", "--json",
        "--accept-dns=false", "--accept-routes=false", "--ssh=false",
        "--shields-up", f"--hostname={hostname}",
    ]
    print("Sign in to Tailscale in the Chrome window. Use this same account on the home node.", flush=True)
    with (state / "signin.stderr.log").open("ab") as log:
        os.chmod(log.name, 0o600)
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=log, text=True)
        buffer = ""
        opened = False
        try:
            for line in process.stdout:
                buffer += line
                try:
                    event, end = json.JSONDecoder().raw_decode(buffer.lstrip())
                except ValueError:
                    continue
                buffer = buffer.lstrip()[end:].lstrip()
                url = event.get("AuthURL")
                if url and not opened:
                    parsed = urllib.parse.urlsplit(url)
                    if parsed.scheme != "https" or parsed.hostname != "login.tailscale.com":
                        raise RuntimeError("Unexpected Tailscale sign-in address.")
                    subprocess.Popen(
                        ["/usr/bin/flatpak", "run", "com.google.Chrome", "--new-window", url],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    )
                    opened = True
                    print("Chrome sign-in opened. Use the same account on both computers.", flush=True)
            if process.wait() != 0:
                raise RuntimeError("Tailscale sign-in did not complete. Reopen this shortcut to retry.")
        finally:
            if process.poll() is None:
                process.terminate()
                process.wait()
    print("This computer is connected to Tailscale. Open m0clip remote desktop or remote OMP to connect.", flush=True)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
