{$APP_HOST} {
	root * /srv
	@internalReceipts path /assets/maps/*/*-report.json /assets/maps/*/source-upgrade.json /assets/characters/*/analysis.json /assets/characters/*/conversion.json /assets/characters/*/rig-map.json /assets/characters/*/source-evidence.json /assets/characters/*/source-manifest.json
	respond @internalReceipts 404
	@mapModels path /assets/maps/*/*.glb
	encode @mapModels zstd gzip {
		match {
			status 200
			header Content-Type model/gltf-binary*
		}
	}
	encode zstd gzip
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		Cross-Origin-Resource-Policy same-origin
		X-Content-Type-Options nosniff
		Cache-Control "public, max-age=0, must-revalidate"
	}
	file_server
}
