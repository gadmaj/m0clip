# deps / build
node_modules/
dist/

# Generated third-party assets are supplied separately; native robot bundles stay
# tracked. Keep parent directories traversable for the deeper negations.
public/assets/*
!public/assets/.gitkeep
!public/assets/models/
public/assets/models/*
!public/assets/models/go2/
!public/assets/models/r1/
!public/assets/models/g1/

# local policy weights cache, written by scripts/import_*.py (never committed)
/assets/

# wasm runtime copied out of node_modules by postinstall
public/wasm/

# policy packs (proprietary weights — bring your own), built by scripts/build-packs.mjs
policy-packs/*.zip
policy-packs/**/*.zip

# python / scratch
__pycache__/
*.pyc
*.log
MUJOCO_LOG*.TXT

# local firmware-work leftovers (decrypted configs, bench notes, old benchmark output)
decrypted/
workbench_configs/
benchmark_results.json

# local development environment and generated asset inspection
/.venv/
/.asset-analysis/

# Local conversion inputs and intermediate assets.
/character-sources/
/.asset-staging/

# node-private project notes (retained outside the repository)
/docs/
/AGENTS.md
/.omp/
/deploy/development/
/deploy/access/
/scripts/development_manifest.py
/scripts/monitor_vm_vitals.py
/scripts/test_monitor_vm_vitals.py
/scripts/test_mowat_link_publisher.py
/scripts/test_public_release.cjs

# Local credentials; example configuration remains publishable.
.env
.env.*
!.env.example
*.pem
*.key
.cloudflared/
